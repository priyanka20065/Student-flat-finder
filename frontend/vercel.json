{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://student-flat-finder-backend.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://student-flat-finder-backend.onrender.com/uploads/:path*"
    },
    {
      "source": "/flat/:id",
      "destination": "/flat/index.html"
    },
    {
      "source": "/roommate/:id",
      "destination": "/roommate/index.html"
    }
  ]
}
